# Backend API (ASP.NET Core). While the backend content endpoints are not ready the site uses the built-in sample data.
NEXT_PUBLIC_API_URL=https://localhost:61847
NEXT_PUBLIC_USE_MOCK=true
# Show dashed "বিজ্ঞাপন" placeholder boxes where ads will appear (turn off when real ads are served)
NEXT_PUBLIC_SHOW_AD_PLACEHOLDERS=true

# Address of the ASP.NET API (server side only). Use the https URL from launchSettings.json;
# run `dotnet dev-certs https --trust` once so Node accepts the development certificate.
API_BASE_URL=https://localhost:61847
